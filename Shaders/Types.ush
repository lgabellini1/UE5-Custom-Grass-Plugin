struct FGrassBladeData
{
	float3 Position;
	float2 Facing;
	float3 TerrainNormal;
	float Height;
	float Width;
	float Tilt;
	float Bend;
	uint Hash;
};

struct FGrassBladeDataPacked
{
	float3 Position;
	uint Hash;
	uint FacingAndNormal;
	uint HeightWidth;
	uint TiltBend;
};

struct FTileAtlasMapping
{
	int LandscapeCoordX;
	int LandscapeCoordY;
	int AtlasTileX;
	int AtlasTileY;
};
